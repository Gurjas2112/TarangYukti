# Copy to .env and fill in. Never commit real values (prompt §5, spec §13.2–13.3).
ENV=local
# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co                                  # or http://127.0.0.1:54321 with the local stack
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=                                                     # channels + worker only
SUPABASE_DB_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres   # migrations + db_roles.sh only
DATABASE_URL=postgresql://ty_api:<password>@<host>:5432/postgres               # no BYPASSRLS
WORKER_DATABASE_URL=postgresql://ty_worker:<password>@<host>:5432/postgres
AGENT_DATABASE_URL=postgresql://ty_agent:<password>@<host>:5432/postgres       # schema agent only (thread memory)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
GOOGLE_OAUTH_CLIENT_ID=                                                        # Google web OAuth client (Supabase provider)
GOOGLE_OAUTH_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="TarangYukti Operations"
# LLM
GOOGLE_API_KEY=
ORCA_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=20                       # then button flows answer from templates
# RAG
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
RAG_MIN_SIM=0.70                       # calibrated 2026-11-03 on the golden set (answerable ≥ 0.752, out-of-scope ≤ 0.665)
# Speech, push
SARVAM_API_KEY=
VAPID_PUBLIC_KEY=                      # npx web-push generate-vapid-keys --json; same value as EXPO_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=                     # worker only, never in the browser
VAPID_SUBJECT=mailto:
EXPO_ACCESS_TOKEN=                     # worker only
# Data
DATA_MODE=online                       # demo.sh sets snapshot on demo day
SNAPSHOT_DATE=                         # YYYY-MM-DD folder in Supabase Storage bucket "snapshots"
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
GFW_API_TOKEN=
# Graph, cache
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io   # or bolt://127.0.0.1:7687 with the local container
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
REDIS_PASSWORD=
REDIS_URL=redis://:<password>@127.0.0.1:6379/0
CACHE_DISABLED=0                       # 1 bypasses both cache tiers (debugging only)
# Wiring, telemetry
MCP_URL=http://127.0.0.1:8001/mcp
AGENT_URL=http://127.0.0.1:8123
WEB_ORIGIN=http://localhost:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Agent improvement loop — test traffic only, never Tier 1
TRACEROOT_ENABLED=false
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=https://app.traceroot.ai
TRACEROOT_ENVIRONMENT=local-eval
TRACEROOT_USER_SALT=
# Azure (Tier 1) — identifiers only
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_ACCOUNT_EMAIL=                   # account linked to the subscription (az login)
AZURE_RESOURCE_GROUP=ty-live
AZURE_LOCATION=centralindia
ONCALL_EMAIL=
# Tier 1 only (set by Bicep)
FRONTDOOR_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
