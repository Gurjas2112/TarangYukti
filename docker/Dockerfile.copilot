# docker/Dockerfile.copilot — ty-copilot, CopilotKit runtime on Node 24 (spec §15.2.1, §17.8).
# ty-copilot is a pnpm workspace member, so `pnpm deploy` produces its standalone production node_modules.
FROM node:24-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY services/copilot/package.json services/copilot/package.json
COPY apps/app/package.json apps/app/package.json
RUN pnpm install --frozen-lockfile --filter @repo/copilot... --ignore-scripts
COPY services/copilot/ services/copilot/
RUN pnpm --filter @repo/copilot deploy --prod --legacy /out

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=8200 COPILOTKIT_TELEMETRY_DISABLED=true
COPY --from=build /out/package.json ./package.json
COPY --from=build /out/node_modules ./node_modules
COPY services/copilot/src ./src
USER node
EXPOSE 8200
CMD ["node", "src/server.ts"]
