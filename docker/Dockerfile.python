# docker/Dockerfile.python — ty-agent, ty-mcp, ty-channels, ty-worker (spec §15.2.1). Build from the repo root:
#   docker build -f docker/Dockerfile.python --build-arg SERVICE_DIR=services/channels -t ty-channels .
# The image mirrors the repo layout under /repo, so path dependencies resolve exactly as on the laptop
# (../../packages/ty-common, and the worker's ../mcp). No BuildKit cache mounts: ACR Tasks uses the classic builder.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.4 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CACHE=1 UV_HTTP_TIMEOUT=120 UV_CONCURRENT_DOWNLOADS=4 PYTHONUNBUFFERED=1 \
    ORCA_CONFIG_DIR=/repo/config TY_DATA_DIR=/repo/data HOST=0.0.0.0
ARG SERVICE_DIR
COPY packages/ /repo/packages/
COPY services/mcp/ /repo/services/mcp/
WORKDIR /repo/${SERVICE_DIR}
COPY ${SERVICE_DIR}/pyproject.toml ${SERVICE_DIR}/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY ${SERVICE_DIR}/ ./
# for ty-mcp the copy above repeats an earlier one (empty layer); the classic builder then fails with
# "layer does not exist" unless a real step follows
RUN true
COPY config/ /repo/config/
COPY data/layers/ /repo/data/layers/
COPY kb/ /repo/kb/
RUN uv sync --frozen --no-dev
RUN useradd --create-home --uid 10001 ty && chown -R ty:ty /repo
USER ty
ENV PATH="/repo/${SERVICE_DIR}/.venv/bin:$PATH"
